# Copiar a .env y ajustar. Las variables VITE_ quedan visibles en el navegador:
# nunca poner aquí contraseñas ni la conexión a la base de datos.

# Backend de UP News (local: npm run dev en el backend)
VITE_API_URL=http://localhost:3000

# Opcional: tiempo real. Supabase → Project Settings → API Keys (la "anon public").
# La anon key es pública por diseño: RLS solo le permite LEER noticias publicadas.
VITE_SUPABASE_URL=https://umpiabkzfaxcbteitcst.supabase.co
VITE_SUPABASE_ANON_KEY=

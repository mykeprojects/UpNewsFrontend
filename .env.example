# Copiar a .env y ajustar. Las variables VITE_ quedan visibles en el navegador:
# nunca poner aquí contraseñas ni la conexión a la base de datos.

# Backend principal del ecosistema (login de la fundación)
VITE_AUTH_API_URL=

# Backend de UP News, terminado en /api (local: npm run dev en el backend)
VITE_NEWS_API_URL=

# Opcional: tiempo real. Supabase → Project Settings → API Keys (la "anon public").
# La anon key es pública por diseño: RLS solo le permite LEER noticias publicadas y activas.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
